{
  "name": "@xpert-ai/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 4390 --strictPort",
    "build": "tsc --noEmit && vite build",
    "icons:macos": "node scripts/generate-macos-icons.mjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:local": "node scripts/test-local.mjs",
    "test:shell:local": "node scripts/test-shell-local.mjs",
    "package": "pnpm build && electron-builder --dir",
    "package:installers": "pnpm build && electron-builder --publish never"
  },
  "devDependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@xpert-ai/contracts": "workspace:*",
    "@xpert-ai/chatkit-types": "catalog:",
    "@xpert-ai/chatkit-web-component": "catalog:",
    "@xpert-ai/shadcn-ui": "workspace:*",
    "docx-preview": "^0.3.7",
    "lucide-react": "^1.21.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.4.5",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.1.18",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "qrcode": "^1.5.4",
    "@types/qrcode": "^1.5.6"
  },
  "build": {
    "appId": "ai.xpert.desktop",
    "productName": "Bosi",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "resources/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "resources/Xpert.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "resources/logo.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "resources/logo.png",
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  },
  "description": "Xpert Bosi - Your AI team leader.",
  "author": "XpertAI",
  "license": "AGPL-3.0",
  "dependencies": {
    "@xpert-ai/desktop-protocol": "workspace:*",
    "electron-updater": "6.8.9",
    "semver": "7.7.3",
    "socket.io-client": "^4.7.5"
  }
}
