{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "targets": {
    "build": {
      "dependsOn": ["^build"],
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "target": "node",
        "compiler": "tsc",
        "memoryLimit": 4096,
        "outputPath": "dist/apps/api",
        "main": "apps/api/src/main.ts",
        "tsConfig": "apps/api/tsconfig.app.json",
        "assets": [
          "apps/api/src/assets",
          {
            "glob": "**/app.{js,css}",
            "input": "packages/server-ai/src/agent-invocation/remote-components",
            "output": "remote-components"
          },
          {
            "glob": "**/app.{js,css}",
            "input": "packages/server-ai/src/knowledgebase/plugins/knowledge-workbench/remote-components",
            "output": "remote-components"
          },
          {
            "glob": "**/app.{js,css}",
            "input": "packages/server-ai/src/xpert-project/remote-components",
            "output": "remote-components"
          },
          {
            "glob": "**/app.{js,css}",
            "input": "packages/server-ai/src/xpert-task/remote-components",
            "output": "remote-components"
          },
          {
            "glob": "**/app.{js,css}",
            "input": "packages/server-ai/src/chat-conversation/conversation-map/remote-components",
            "output": "remote-components"
          },
          {
            "glob": "**/migrations/**/*.{sql,json}",
            "input": "packages/server/src",
            "output": "database-migrations/core"
          },
          {
            "glob": "**/migrations/**/*.{sql,json}",
            "input": "packages/server-ai/src",
            "output": "database-migrations/ai"
          },
          {
            "glob": "database/platform-baseline/{current,types}.sql",
            "input": "packages/server/src",
            "output": "database-migrations/core"
          },
          {
            "glob": "database-migrations.json",
            "input": ".deploy/api",
            "output": "database-migrations"
          }
        ],
        "webpackConfig": "apps/api/config/webpack.config.js"
      },
      "configurations": {
        "development": {},
        "production": {
          "buildLibsFromSource": false
        }
      }
    },
    "build-agent-results": {
      "executor": "nx:noop",
      "dependsOn": [
        {
          "target": "build-remote-components",
          "projects": ["server-ai"]
        }
      ]
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "api:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "api:build:development"
        },
        "production": {
          "buildTarget": "api:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/api/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/api/jest.config.ts"
      }
    },
    "build-coding-execution": {
      "executor": "nx:noop",
      "dependsOn": [
        {
          "target": "build-remote-components",
          "projects": ["server-ai"]
        }
      ]
    },
    "build-conversation-map": {
      "executor": "nx:noop",
      "dependsOn": [
        {
          "target": "build-remote-components",
          "projects": ["server-ai"]
        }
      ]
    }
  },
  "tags": []
}
