{
  "restartable": "rs",
  "signal": "SIGTERM",
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/remote-components/**/app.js",
    "**/remote-components/**/app.css",
    "**/*.spec.ts",
    "**/*.test.*"
  ],
  "watch": [
    "apps/api",
    "packages/contracts/src",
    "packages/common/src",
    "packages/config/src",
    "packages/server/src",
    "packages/auth/src",
    "packages/server-ai/src",
    "packages/plugin-sdk/src",
    "packages/plugins",
    ".deploy/api/database-migrations.json",
    "tools/scripts/start-api.mjs",
    "package.json",
    "tsconfig.base.json",
    "nx.json"
  ],
  "exec": "node tools/scripts/start-api.mjs",
  "env": {
    "NODE_ENV": "development"
  },
  "ext": "ts,js,mjs,cjs,cts,json,sql"
}
