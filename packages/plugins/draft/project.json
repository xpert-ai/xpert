{
  "name": "draft",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/plugins/draft/src",
  "projectType": "library",
  "release": {
    "version": {
      "generatorOptions": {
        "packageRoot": "dist/{projectRoot}",
        "currentVersionResolver": "git-tag"
      }
    }
  },
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/rollup:rollup",
      "inputs": ["production", "^production", "{workspaceRoot}/tools/remote-components/**/*"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/plugins/draft",
        "main": "packages/plugins/draft/src/index.ts",
        "tsConfig": "packages/plugins/draft/tsconfig.lib.json",
        "assets": [
          {
            "glob": "*.yaml",
            "input": "packages/plugins/draft/src/lib/customer-intent/templates",
            "output": "templates"
          },
          {
            "glob": "app.*",
            "input": "packages/plugins/draft/remote-components/intent-review",
            "output": "remote-components/intent-review"
          }
        ],
        "project": "packages/plugins/draft/package.json",
        "compiler": "swc",
        "format": ["cjs", "esm"],
        "external": [
          "@xpert-ai/contracts",
          "@langchain/core",
          "yaml",
          "@nestjs/config",
          "@nestjs/common",
          "@nestjs/core",
          "@nestjs/microservices",
          "@xpert-ai/plugin-sdk",
          "aws-sdk",
          "moment",
          "multer-s3",
          "kafkajs",
          "amqplib",
          "mqtt",
          "nats",
          "uuid",
          "zod"
        ]
      },
      "dependsOn": ["^build", "generate-remote-components"]
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/plugins/draft/jest.config.ts"
      }
    },
    "generate-remote-components": {
      "dependsOn": [{ "target": "build", "projects": ["plugin-sdk"] }],
      "executor": "nx:run-commands",
      "options": {
        "command": "node packages/plugins/draft/remote-components/intent-review/build.mjs"
      }
    }
  }
}
