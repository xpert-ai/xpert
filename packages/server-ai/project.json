{
    "name": "server-ai",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "packages/server-ai/src",
    "projectType": "library",
    "targets": {
        "build": {
            "executor": "@nx/js:tsc",
            "outputs": ["{options.outputPath}"],
            "dependsOn": [
                "^build",
                {
                    "target": "build-remote-components"
                }
            ],
            "options": {
                "outputPath": "dist/packages/server-ai",
                "tsConfig": "packages/server-ai/tsconfig.lib.json",
                "packageJson": "packages/server-ai/package.json",
                "main": "packages/server-ai/src/index.ts",
                "assets": [
                    {
                        "glob": "src/**/remote-components/*/app.{js,css}",
                        "input": "packages/server-ai/",
                        "output": "./",
                        "includeIgnoredFiles": true
                    },
                    {
                        "glob": "**/*.(csv|json|js|css|svg|png|jpg|yaml|yml|py|sh|sql|md|txt)",
                        "input": "packages/server-ai/",
                        "output": "./"
                    }
                ]
            }
        },
        "build-remote-components": {
            "executor": "nx:run-commands",
            "outputs": [
                "{projectRoot}/src/**/remote-components/**/app.js",
                "{projectRoot}/src/**/remote-components/**/app.css"
            ],
            "options": {
                "command": "node packages/server-ai/scripts/build-remote-components.mjs",
                "cwd": "."
            },
            "cache": true,
            "inputs": [
                "^production",
                "{projectRoot}/src/**/remote-components/**/*",
                "!{projectRoot}/src/**/remote-components/**/app.js",
                "!{projectRoot}/src/**/remote-components/**/app.css",
                "{projectRoot}/scripts/build-remote*.mjs",
                "{projectRoot}/tsconfig*.json",
                "{projectRoot}/package.json",
                "{projectRoot}/src/chat-conversation/conversation-map/schema.ts",
                "{projectRoot}/src/shared/coding-tools/**/*",
                "{workspaceRoot}/packages/contracts/src/**/*",
                "{workspaceRoot}/packages/plugin-sdk/src/**/*",
                "{workspaceRoot}/packages/shadcn-ui/src/**/*",
                "{workspaceRoot}/tsconfig.base.json",
                "{workspaceRoot}/package.json",
                "{workspaceRoot}/pnpm-lock.yaml",
                "{projectRoot}/src/view-extension/remote-context.ts",
                "{workspaceRoot}/packages/contracts/package.json",
                "{workspaceRoot}/packages/plugin-sdk/package.json",
                "{workspaceRoot}/packages/shadcn-ui/package.json"
            ],
            "dependsOn": [
                {
                    "target": "build",
                    "projects": ["plugin-sdk"]
                }
            ]
        },
        "publish": {
            "executor": "nx:run-commands",
            "options": {
                "command": "node tools/scripts/publish.mjs server {args.ver} {args.tag}"
            },
            "dependsOn": [
                {
                    "target": "build"
                }
            ]
        },
        "lint": {
            "executor": "@nx/eslint:lint",
            "outputs": ["{options.outputFile}"],
            "options": {
                "lintFilePatterns": ["packages/server-ai/src/**/*.ts"]
            }
        },
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/packages/server-ai"],
            "options": {
                "jestConfig": "packages/server-ai/jest.config.ts"
            }
        }
    },
    "tags": [],
    "namedInputs": {
        "default": [
            "{projectRoot}/**/*",
            "sharedGlobals",
            "!{projectRoot}/src/**/remote-components/**/app.js",
            "!{projectRoot}/src/**/remote-components/**/app.css"
        ]
    }
}
