{
	"name": "analytics",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/analytics/src",
	"projectType": "library",
	"targets": {
		"build": {
			"executor": "@nx/js:tsc",
			"dependsOn": [
				"^build",
				{
					"target": "generate-remote-components",
					"projects": "self"
				}
			],
			"outputs": ["{options.outputPath}"],
			"options": {
				"outputPath": "dist/packages/analytics",
				"tsConfig": "packages/analytics/tsconfig.lib.json",
				"packageJson": "packages/analytics/package.json",
				"main": "packages/analytics/src/index.ts",
				"assets": [
					{
						"glob": "**/*.(csv|json|svg|png|jpg|yaml|yml|html|css|js)",
						"input": "packages/analytics/",
						"output": "./"
					},
					{
						"glob": "*.md",
						"input": "packages/analytics/",
						"output": "./"
					}
				]
			}
		},
		"generate-remote-components": {
			"executor": "nx:run-commands",
			"outputs": [
				"{projectRoot}/src/plugins/datax-semantic-modeling/remote-components/semantic-modeling/app.js",
				"{projectRoot}/src/plugins/datax-semantic-modeling/remote-components/semantic-modeling/app.css",
				"{projectRoot}/src/plugins/datax-metric-management/remote-components/metric-management/app.js",
				"{projectRoot}/src/plugins/datax-metric-management/remote-components/metric-management/app.css",
				"{projectRoot}/src/plugins/datax-query-analysis/remote-components/query-analysis/app.js",
				"{projectRoot}/src/plugins/datax-query-analysis/remote-components/query-analysis/app.css"
			],
			"options": {
				"command": "node packages/analytics/src/plugins/remote-components/build-apps.mjs",
				"cwd": "."
			}
		},
		"check-remote-components": {
			"executor": "nx:run-commands",
			"outputs": [],
			"options": {
				"command": "corepack pnpm exec tsc -p packages/analytics/tsconfig.remote.json --noEmit && node packages/analytics/src/plugins/remote-components/build-apps.mjs --check",
				"cwd": "."
			}
		},
		"publish": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node tools/scripts/publish.mjs analytics {args.ver} {args.tag}"
			},
			"dependsOn": [
				{
					"target": "build"
				}
			]
		},
		"lint": {
			"executor": "@nx/eslint:lint",
			"outputs": ["{options.outputFile}"],
			"options": {
				"lintFilePatterns": ["packages/analytics/**/*.ts"]
			}
		},
		"test": {
			"executor": "@nx/jest:jest",
			"outputs": ["{workspaceRoot}/coverage/packages/analytics"],
			"options": {
				"jestConfig": "packages/analytics/jest.config.ts"
			}
		}
	},
	"tags": []
}
