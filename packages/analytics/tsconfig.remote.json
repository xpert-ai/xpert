{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"allowJs": false,
		"checkJs": false,
		"declaration": false,
		"emitDecoratorMetadata": false,
		"experimentalDecorators": false,
		"jsx": "react-jsx",
		"lib": ["DOM", "ES2022"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noPropertyAccessFromIndexSignature": false,
		"baseUrl": "../..",
		"paths": {
			"@/*": ["packages/shadcn-ui/src/*"],
			"@xpert-ai/shadcn-ui": ["packages/shadcn-ui/src/index.ts"]
		},
		"skipLibCheck": true,
		"strict": true,
		"strictNullChecks": true,
		"target": "ES2022",
		"types": ["react", "react-dom"]
	},
	"include": [
		"src/plugins/remote-components/shared/**/*.ts",
		"src/plugins/datax-semantic-modeling/remote-components/**/*.ts",
		"src/plugins/datax-semantic-modeling/remote-components/**/*.tsx",
		"src/plugins/datax-metric-management/remote-components/**/*.ts",
		"src/plugins/datax-metric-management/remote-components/**/*.tsx",
		"src/plugins/datax-query-analysis/remote-components/**/*.ts",
		"src/plugins/datax-query-analysis/remote-components/**/*.tsx"
	],
	"exclude": ["**/*.spec.ts"]
}
