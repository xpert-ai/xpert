{
  "name": "@xpert-ai/plugin-sdk",
  "version": "3.18.6",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/xpert-ai/xpert.git"
  },
  "bugs": {
    "url": "https://github.com/xpert-ai/xpert/issues"
  },
  "main": "./index.cjs",
  "module": "./index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.cjs.js"
    },
    "./data-workbench": {
      "types": "./dist/data-workbench.d.ts",
      "import": "./dist/data-workbench.esm.js",
      "default": "./dist/data-workbench.cjs.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "dependencies": {
    "@langchain/openai": "0.6.9",
    "@xpert-ai/contracts": "workspace:*",
    "express": "^4.22.1",
    "js-tiktoken": "^1.0.21"
  },
  "peerDependencies": {
    "@langchain/core": "*",
    "@nestjs/common": "*",
    "@nestjs/core": "*",
    "@nestjs/cqrs": "*",
    "ajv": "*",
    "i18next": "*",
    "i18next-fs-backend": "*",
    "json-schema": "*",
    "jsonwebtoken": "*",
    "lodash-es": "*",
    "passport-jwt": "*",
    "rxjs": "*",
    "yaml": "*",
    "zod": "^3.25.0 || ^4.0.0"
  }
}
