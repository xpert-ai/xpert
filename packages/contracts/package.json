{
  "name": "@xpert-ai/contracts",
  "version": "3.38.1",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/xpert-ai/xpert.git"
  },
  "bugs": {
    "url": "https://github.com/xpert-ai/xpert/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/index.esm.js",
      "default": "./index.cjs.js"
    },
    "./context-event": {
      "types": "./dist/context-event.d.ts",
      "module": "./dist/context-event.esm.js",
      "default": "./dist/context-event.cjs.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "scripts": {
    "docs": "pnpm typedoc --out ./.docs"
  },
  "module": "./index.esm.js",
  "main": "./index.cjs.js",
  "dependencies": {
    "@octokit/types": "13.10.0",
    "@types/json-schema": "^7.0.15",
    "@xpert-ai/chatkit-types": "catalog:",
    "zod-to-json-schema": "^3.25.2"
  },
  "peerDependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  }
}
